<!DOCTYPE html>
<html lang="en">
    <head>
        {{ head }}
    </head>
    <body id="top">
        {{ before }}
        {{ header }}
        <main id="content">
            <div>
                <h2 class="creation-title">{{ data: title }}</h2>
                {{ data: date }}
                {{ data: tags }}
                <p class="creation-subtitle" style="margin:0;"><a href="{{ data: link }}" target="blank">alternative link</a></p>
                <p>{{ data: text }}</p>
            </div>
        </main>
        <footer>
            <p>{{ last_modified }}</p>
        </footer>
        {{ after }}
    </body>
</html>