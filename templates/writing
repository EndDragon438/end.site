<!DOCTYPE html>
<html lang="en">
    <head>
        {{ head }}
        <link href="/stylesheets/creations.css" rel="stylesheet" type="text/css" media="all">
    </head>
    <body id="top">
        {{ before }}
        {{ header }}
        <main id="content">
            <div>
                <h1 class="creation-title">{{ data: title }}</h1>
                <h2 class="creation-subtitle">{{ data: subtitle }}</h2>
                <h3 class="creation-date">{{ data: date }}</h3>
                {{ data: tags }}
                <b class="creation-subtitle" style="margin:0;"><a href="{{ data: link }}" target="blank">alternative link</a></b><br>
                <p>{{ data: text }}</p>
            </div>
        </main>
        <footer>
            <p>{{ last_modified }}</p>
        </footer>
        {{ after }}
    </body>
</html>