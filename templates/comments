<div>
    <iframe name="dummy_frame" id="dummy_frame" style="display: none;"></iframe>
    <input id="page" name="page" type="text" maxlength="256" form="comments" style="display: none" value="{{ gen: path }}"> <!-- hidden and set to a default -->
    <form id="comments" action="https://end-site-backend.alwaysdata.net/comment.php" method="post" target="dummy_frame" style="display: flex; flex-flow: row wrap; justify-content: space-between; gap: 1em;">
        <!-- page, name, website, email, body -->
        <label for="name">
            Username<span class="required">*</span>
            <input id="name" name="name" type="text" maxlength="128" placeholder="end draconis" required>
        </label>
        
        <label for="website">
            Website (optional)
            <input id="website" name="website" type="text" maxlength="128" placeholder="https://end-draconis.neocities.org">
        </label>
        
        <label for="email">
            Email (optional, <em>never</em> public, for private conversations)
            <input id="email" name="email" type="text" maxlength="256" placeholder="end@email.com">
        </label>
        
        <label for="body" style="width: 100%; display: flex; flex-flow: row nowrap;">
            Comment<span class="required">*</span>
            <textarea id="body" name="body" rows="8" placeholder="what have you got to say?" required style="width: 100%; height: 100%; margin-left: 1em;"></textarea>
        </label>
        <button type="submit" style="margin: auto; padding: 0.2em;">Submit Comment</button>
    </form>
</div>