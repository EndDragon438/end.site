<div id="themePicker">
    <details>
        <summary>Swap themes</summary>
        <fieldset class="themeSet" id="colourSet">
            <legend>Colours</legend>
            <span>
                <input type="radio" name="colours" id="draconicColours">
                <label for="draconicColours">Draconic</label>
            </span>
            <span>
                <input type="radio" name="colours" id="hackerColours">
                <label for="hackerColours">Hacker</label>
            </span>
            <span>
                <input type="radio" name="colours" id="bloodColours">
                <label for="bloodColours">Blood</label>
            </span>
            <span>
                <input type="radio" name="colours" id="transColours">
                <label for="transColours">Trans</label>
            </span>
            <span>
                <input type="radio" name="colours" id="darkColours" checked>
                <label for="darkColours">Dark</label>
            </span>
            <span>
                <input type="radio" name="colours" id="lightColours">
                <label for="lightColours">Light</label>
            </span>
        </fieldset>
        <fieldset class="themeSet" id="fontSet">
            <legend>Fonts</legend>
            <span>
                <input type="radio" name="fonts" id="draconicFonts" checked>
                <label for="draconicFonts">Draconic</label>
            </span>
            <span>
                <input type="radio" name="fonts" id="regularFonts">
                <label for="regularFonts">Regular</label>
            </span>
        </fieldset>
    </details>
</div>
<script>
    // all this does is save the theme preference to localStorage
    // if it's disabled the theme won't save across pages/reloads
    // but can still be changed.
    
    // List of the theme types
    const themes = ['colours', 'fonts'];
    
    // Make sure localStorage has *some* value
    if (!themes.every((elem) => localStorage['data-' + elem])) {
        saveTheme();
    }
    
    // On load, load the currently selected theme
    loadTheme();
    
    // Save theme whenever the themepicker changes
    document.getElementById('themePicker').addEventListener('click', (event) => saveTheme());

    function saveTheme() {
        for (const theme of themes) {
            localStorage['data-' + theme] = document.querySelector(`#themePicker input[name="${theme}"]:checked`).id;
        }
    }
    
    function loadTheme() {
        for (const theme of themes) {
            for (const elem of document.querySelectorAll(`#themePicker input[name="${theme}"]`)) {
                if (localStorage['data-' + theme] && localStorage['data-' + theme] === elem.id) {
                    elem.checked = true;
                } else {
                    elem.checked = false;
                }
            }
        }
    }
</script>